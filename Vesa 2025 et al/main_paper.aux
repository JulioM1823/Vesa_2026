\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Temporally averaged spatial distributions of the phase weighted coherence between the filtered Fe\,{\sc  i}\,5434--K\,{\sc  i}\,7699 diagnostics within 0.7--3.1\,mHz, overlaid with unsigned magnetic field and inclination contours. Regions outside the contours correspond to QS ($|B| < 30$\,G) and predominantly horizontal fields ($75\ensuremath  {^\circ }\leq \gamma \leq 106\ensuremath  {^\circ }$). Inclination data are unavailable for DS0 and DS1. Magnetic field contours: dotted hatching marks intermediate fields ($30$\,G $< |B| \leq 100$\,G); square hatching marks strong fields ($|B| > 100$\,G). Inclination contours: vertically oriented fields are hatched (stars: $0\ensuremath  {^\circ }\leq \gamma < 75\ensuremath  {^\circ }$; diagonals: $106\ensuremath  {^\circ }< \gamma \leq 180\ensuremath  {^\circ }$).\relax }}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:IBIS_spatial_distribution_phases}{{5}{13}{Temporally averaged spatial distributions of the phase weighted coherence between the filtered \IBISFeUpperPhot {}--\IBISK {} diagnostics within 0.7--3.1\,mHz, overlaid with unsigned magnetic field and inclination contours. Regions outside the contours correspond to QS ($|B| < 30$\,G) and predominantly horizontal fields ($75\degree \leq \gamma \leq 106\degree $). Inclination data are unavailable for DS0 and DS1. Magnetic field contours: dotted hatching marks intermediate fields ($30$\,G $< |B| \leq 100$\,G); square hatching marks strong fields ($|B| > 100$\,G). Inclination contours: vertically oriented fields are hatched (stars: $0\degree \leq \gamma < 75\degree $; diagonals: $106\degree < \gamma \leq 180\degree $).\relax }{figure.caption.9}{}}
